import numpy as np

DAILY_BUDGET = 600_000

UQ_FAIR_VALUE = 100.0

FINTECH_WARMUP = 30
FINTECH_EWMA_CONFIGS = (
    (0.85, 0.75),
    (0.90, 0.80),
    (0.95, 0.85),
)

JEANS_Q_LEVEL = 0.5
JEANS_Q_SLOPE = 0.05
JEANS_OBSERVATION_VARIANCE = 5.0
JEANS_INITIAL_SLOPE_VARIANCE = 1.0
JEANS_SHORT_CONFIDENCE = 0.5
JEANS_ALPHA = 0.06
JEANS_TREND_THRESHOLD = 0.6
JEANS_REVERT_THRESHOLD = 0.2

MENUDASH_WARMUP = 45
MENUDASH_MAPPING_WINDOWS = (20, 60, 120)

FOOD_EMA_ALPHAS = (0.10, 0.15, 0.20)

SIZZLE_WINDOW = 15
SIZZLE_SEED = np.array([
    0.00530057,  # Intercept
    0.07690641,  # Bread change
    1.67799649,  # Sausage change
])

BOAT_VOL_WINDOW = 10
BOAT_ALPHA = 0.65
BOAT_REVERT_THRESHOLD = 0.05

BOAT_PARTY_SIGNALS = (
    "00-+000000-00+00-+00++-0-+-0-+-+00+0000+-0000+000-+000---+-0---0000-0--00-+000000-0--+-00000"
    "-+0-00+0-+00+0000-++-0+-+---+-+0--0-+00--0+0-00000-00+++00000-00000-0000000+-0-+00+0+000-++-"
    "0+-0+-000-+-000-00-+0-+-0--000-+-000+-00000000-+00-00+000+-0+000000-00+000-+00-00-+00-+--000"
    "0+0-00-+-0+-0+00+-0000+00+-0+00+-00+0-+-00-++-0000+00000-00-++-0000-00-+0000000+-+-000-0+"
)
        
class Algorithm():
    def __init__(self, positions):
        self.data = {}  
        self.positionLimits = {}  
        self.day = 0     
        self.positions = positions 

    def scale_portfolio(self, positions: dict[str, int]) -> dict[str, int]:
        exposure = 0.0

        for instrument, position in positions.items():
            price = self.get_current_price(instrument)
            exposure += abs(position) * price

        if exposure <= DAILY_BUDGET:
            return positions

        scale = DAILY_BUDGET / exposure
        scaled = {}

        for instrument, position in positions.items():
            scaled[instrument] = int(position * scale)

        return scaled

    def _thrifted_jeans_position(self) -> int:
        prices = self.get_seen_prices("Thrifted Jeans")
        limit = self.positionLimits["Thrifted Jeans"]

        if self.day == 0:
            return 0

        transition = np.array([[1.0, 1.0], [0.0, 1.0]])
        process_covariance = np.diag([JEANS_Q_LEVEL, JEANS_Q_SLOPE])
        observation_vector = np.array([1.0, 0.0])

        state = np.array([prices[0], 0.0])

        covariance = np.diag([
            JEANS_OBSERVATION_VARIANCE,
            JEANS_INITIAL_SLOPE_VARIANCE,
        ])

        for day, price in enumerate(prices):
            if day > 0:
                state = transition @ state
                covariance = (
                    transition @ covariance @ transition.T + process_covariance
                )

            innovation = price - float(observation_vector @ state)

            innovation_variance = (
                float(observation_vector @ covariance @ observation_vector)
                + JEANS_OBSERVATION_VARIANCE
            )

            gain = (
                covariance @ observation_vector
                / max(innovation_variance, 1e-12)
            )

            state += gain * innovation
            covariance = covariance - np.outer(
                gain, observation_vector @ covariance
            )

            covariance = (covariance + covariance.T) / 2.0

        estimated_slope = float(state[1])
        slope_uncertainty = np.sqrt(max(float(covariance[1, 1]), 0.0))
        trend_strength = abs(estimated_slope) / max(slope_uncertainty, 1e-12)

        if trend_strength >= JEANS_TREND_THRESHOLD:
            if estimated_slope < -JEANS_SHORT_CONFIDENCE * slope_uncertainty:
                return -limit

            return limit

        fair_value = prices[0]

        for p in prices[1:]:
            fair_value += JEANS_ALPHA * (p - fair_value)

        residuals = prices - fair_value
        res_std = max(float(np.std(residuals)), 1e-12)

        z_score = (prices[-1] - fair_value) / res_std
        current_pos = self.positions["Thrifted Jeans"]

        if current_pos == 0:
            if z_score >= JEANS_REVERT_THRESHOLD:
                return -limit
            
            elif z_score <= -JEANS_REVERT_THRESHOLD:
                return limit
            
            return 0
        
        elif current_pos * z_score > 0:
            if abs(z_score) >= JEANS_REVERT_THRESHOLD:
                return -current_pos
            
            return 0
        
        return current_pos

    def _uq_dollar_position(self) -> int:
        price = self.get_current_price("UQ Dollar")
        limit = self.positionLimits["UQ Dollar"]

        if price > UQ_FAIR_VALUE:
            return -limit

        if price < UQ_FAIR_VALUE:
            return limit

        return 0

    def _sausage_sizzle_position(self) -> int:        
        bread = self.get_seen_prices("Bread")
        sausage = self.get_seen_prices("Sausage")
        sizzle = self.get_seen_prices("Sausage Sizzle")

        limit = self.positionLimits["Sausage Sizzle"]

        if self.day == 0:
            return 0

        current_features = np.array([
            1.0,
            bread[self.day] - bread[self.day - 1],
            sausage[self.day] - sausage[self.day - 1],
        ])

        if self.day <= SIZZLE_WINDOW:
            coefficients = SIZZLE_SEED

        else:
            start = self.day - SIZZLE_WINDOW
            feature_rows = []
            targets = []

            for observation_day in range(start, self.day):
                feature_rows.append(
                    [
                        1.0,
                        bread[observation_day] - bread[observation_day - 1],
                        sausage[observation_day] - sausage[observation_day - 1],
                    ]
                )

                targets.append(
                    sizzle[observation_day + 1] - sizzle[observation_day]
                )

            design = np.asarray(feature_rows, dtype=float)
            targets = np.asarray(targets, dtype=float)

            coefficients, *_ = np.linalg.lstsq(design, targets, rcond=None)

        predicted_change = float(current_features @ coefficients)

        if predicted_change > 0:
            return limit

        if predicted_change < 0:
            return -limit

        return 0

    def _menudash_position(self) -> int:
        menu = self.get_seen_prices("MenuDash")
        sizzle = self.get_seen_prices("Sausage Sizzle")
        bread = self.get_seen_prices("Bread")
        sausage = self.get_seen_prices("Sausage")

        limit = self.positionLimits["MenuDash"]

        if self.day < MENUDASH_WARMUP:
            return 0

        observation_days = np.arange(1, self.day)

        change_design = np.column_stack([
            np.ones(len(observation_days)),
            bread[observation_days] - bread[observation_days - 1],
            sausage[observation_days] - sausage[observation_days - 1],
        ])

        change_targets = (
            sizzle[observation_days + 1] - sizzle[observation_days]
        )

        ingredient_coefficients, *_ = np.linalg.lstsq(
            change_design, change_targets, rcond=None,
        )

        bread_loading = ingredient_coefficients[1]
        sausage_loading = ingredient_coefficients[2]

        labour_sensor = (
            sizzle[1:self.day+1]
            - bread_loading * bread[:self.day]
            - sausage_loading * sausage[:self.day]
        )

        menu_targets = menu[:self.day]
        latest_sensor = labour_sensor[-1]

        votes = 0

        for mapping_window in MENUDASH_MAPPING_WINDOWS:
            sensor_history = labour_sensor
            target_history = menu_targets

            if mapping_window is not None:
                sensor_history = sensor_history[-mapping_window:]
                target_history = target_history[-mapping_window:]

            mapping_design = np.column_stack([
                np.ones(len(sensor_history)),
                sensor_history,
            ])

            mapping_coefficients, *_ = np.linalg.lstsq(
                mapping_design, target_history, rcond=None,
            )

            fair_value = float(
                mapping_coefficients @ np.array([1.0, latest_sensor])
            )

            votes += int(np.sign(fair_value - menu[self.day]))

        if votes > 0:
            return limit

        if votes < 0:
            return -limit

        return 0

    def _food_ema_position(self, instrument: str) -> int:
        prices = self.get_seen_prices(instrument)

        if len(prices) < 2:
            return 0

        votes = 0

        for alpha in FOOD_EMA_ALPHAS:
            level = prices[0]

            for historical_price in prices[1:-1]:
                level = alpha * historical_price + (1.0 - alpha) * level

            votes += int(np.sign(prices[-1] - level))

        limit = self.positionLimits[instrument]

        if votes > 0:
            return limit

        if votes < 0:
            return -limit

        return 0

    def _fintech_token_position(self) -> int:
        instrument = "Fintech Token"
        prices = self.get_seen_prices(instrument)
        limit = self.positionLimits[instrument]

        if self.day == 0:
            return 0

        changes = np.diff(prices)
        latest_change = float(changes[-1])

        if not np.isfinite(latest_change) or latest_change == 0:
            return 0

        latest_direction = int(np.sign(latest_change))

        if len(changes) <= FINTECH_WARMUP:
            return -limit * latest_direction

        votes = 0

        for decay, percentile in FINTECH_EWMA_CONFIGS:
            variance = float(changes[0] ** 2)
            volatility_history = [np.sqrt(variance)]

            for change in changes[1:]:
                variance = decay * variance + (1.0 - decay) * float(change**2)
                volatility_history.append(np.sqrt(max(variance, 0.0)))

            current_volatility = volatility_history[-1]

            threshold = float(np.quantile(
                volatility_history[:-1],
                percentile,
            ))

            regime_direction = 1 if current_volatility >= threshold else -1
            votes += regime_direction * latest_direction

        if votes > 0:
            return limit

        if votes < 0:
            return -limit

        return 0

    def _boat_party_position(self) -> int:
        instrument = "Boat Party Ticket"
        limit = self.positionLimits[instrument]
    
        if self.day < BOAT_VOL_WINDOW:
            return 0

        current_price = self.get_current_price(instrument)
            
        if not hasattr(self, "_boat_ewma"):
            self._boat_ewma = current_price
        else:
            self._boat_ewma += BOAT_ALPHA * (current_price - self._boat_ewma)
        
        day_of_year = self.day % 365
        regime = BOAT_PARTY_SIGNALS[day_of_year]
        
        if regime == '+':
            return limit
        
        elif regime == '-':
            return -limit

        price_window = self.get_seen_prices(instrument, BOAT_VOL_WINDOW)
        rolling_vol = max(float(np.std(price_window)), 1e-12)

        z_score = (current_price - self._boat_ewma) / rolling_vol
        
        current_pos = self.positions[instrument]
        
        if current_pos == 0:
            if z_score >= BOAT_REVERT_THRESHOLD:
                return -limit
            
            elif z_score <= -BOAT_REVERT_THRESHOLD:
                return limit
            
            return 0
            
        elif current_pos * z_score > 0:
            if abs(z_score) >= BOAT_REVERT_THRESHOLD:
                return -current_pos
            
            return 0
            
        return current_pos

    def get_seen_prices(self, instrument: str, window: int = 0) -> np.ndarray:
        if window < 0:
            raise ValueError("Window must be non-negative.")

        prices = np.asarray(self.data[instrument], dtype=float)

        if window == 0:
            return prices

        return prices[-window:]

    def get_current_price(self, instrument: str) -> float:
        return self.data[instrument][-1]
    
    def get_positions(self) -> dict[str, int]:
        position_limits = self.positionLimits

        desired_positions = {}

        for instrument, _ in position_limits.items():
            desired_positions[instrument] = 0

        desired_positions["UQ Dollar"] = self._uq_dollar_position()
        desired_positions["Fintech Token"] = self._fintech_token_position()
        desired_positions["Thrifted Jeans"] = self._thrifted_jeans_position()
        desired_positions["Bread"] = self._food_ema_position("Bread")
        desired_positions["Sausage"] = self._food_ema_position("Sausage")
        desired_positions["Sausage Sizzle"] = self._sausage_sizzle_position()
        desired_positions["MenuDash"] = self._menudash_position()
        desired_positions["Boat Party Ticket"] = self._boat_party_position()

        return self.scale_portfolio(desired_positions)
